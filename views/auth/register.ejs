<%- include('../partials/header', { title }) %>
<section class="auth-shell">
  <div><span class="eyebrow">JOIN THE LOOP</span><h1>작은 물건의<br>다음 이야기를 시작하세요.</h1><p>가입 즉시 가상 화폐 10,000P가 지급됩니다.</p></div>
  <form class="card form" method="post" action="/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>아이디<input name="username" required minlength="4" maxlength="24" pattern="[A-Za-z0-9_]+" autocomplete="username"><small>영문, 숫자, 밑줄 4~24자</small></label>
    <label>닉네임<input name="nickname" required minlength="2" maxlength="30"></label>
    <label>비밀번호<input type="password" name="password" required minlength="11" maxlength="128" autocomplete="new-password"><small>11자 이상, 영문·숫자·특수문자 각 1자 이상</small></label>
    <button class="button wide">계정 만들기</button>
  </form>
</section>
<%- include('../partials/footer') %>

<%- include('partials/header', { title }) %>
<section class="profile-hero card"><div class="avatar"><%= profile.nickname.slice(0, 1) %></div><div><span class="eyebrow">MEMBER PROFILE</span><h1><%= profile.nickname %></h1><p><%= profile.bio || '아직 소개글이 없습니다.' %></p><small>가입일 <%= profile.createdAt.toLocaleDateString('ko-KR') %></small></div></section>
<div class="section-head"><h2>판매 중인 상품</h2></div><div class="simple-list"><% profile.products.forEach((product) => { %><a href="/products/<%= product.id %>"><span><%= product.name %></span><strong><%= product.price.toLocaleString() %>P</strong></a><% }) %></div>
<% if (currentUser && currentUser.id !== profile.id) { %><section class="card compact"><h2>사용자 관리</h2><div class="actions"><form method="post" action="/users/<%= profile.id %>/block"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary">사용자 차단</button></form><form class="report-inline" method="post" action="/reports/user/<%= profile.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" minlength="5" maxlength="500" required placeholder="신고 사유 (5자 이상)"><button class="danger">신고</button></form></div></section><% } %>
<%- include('partials/footer') %>

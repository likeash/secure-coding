<%- include('partials/header', { title }) %>
<div class="page-head"><div><span class="eyebrow">MY TINY</span><h1>안녕하세요, <%= currentUser.nickname %>님.</h1></div><div class="balance"><small>보유 포인트</small><strong><%= currentUser.balance.toLocaleString() %>P</strong></div></div>
<div class="dashboard-grid">
  <form class="card form" method="post" action="/mypage/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>프로필</h2><label>닉네임<input name="nickname" value="<%= currentUser.nickname %>" minlength="2" maxlength="30" required></label><label>소개글<textarea name="bio" maxlength="500" rows="5"><%= currentUser.bio %></textarea></label><button class="button">저장</button></form>
  <form class="card form" method="post" action="/mypage/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>비밀번호 변경</h2><label>현재 비밀번호<input type="password" name="currentPassword" required autocomplete="current-password"></label><label>새 비밀번호<input type="password" name="newPassword" minlength="11" required autocomplete="new-password"><small>11자 이상, 영문·숫자·특수문자 포함</small></label><label>새 비밀번호 확인<input type="password" name="confirmPassword" minlength="11" required autocomplete="new-password"></label><button class="button secondary">변경</button></form>
</div>
<div class="quick-links"><a href="/products/mine">내 상품 관리 →</a><a href="/users/<%= currentUser.id %>">공개 프로필 보기 →</a></div>
<div class="section-head"><h2>거래 내역</h2><p class="muted">상품 상세 페이지에서 구매하면 이곳에 기록됩니다.</p></div><div class="table-wrap"><table><thead><tr><th>일시</th><th>상품명</th><th>구분</th><th>구매자</th><th>판매자</th><th>금액</th><th>상태</th></tr></thead><tbody><% transfers.forEach((transfer) => { const sent = transfer.senderId === currentUser.id; %><tr><td><%= transfer.createdAt.toLocaleString('ko-KR') %></td><td><%= transfer.product?.name || '-' %></td><td><%= sent ? '구매' : '판매' %></td><td><%= transfer.sender.nickname %></td><td><%= transfer.receiver.nickname %></td><td class="<%= sent ? 'minus' : 'plus' %>"><%= sent ? '-' : '+' %><%= transfer.amount.toLocaleString() %>P</td><td><%= transfer.status %></td></tr><% }) %></tbody></table></div>
<%- include('partials/footer') %>

<%- include('../partials/header', { title }) %>
<div class="page-head"><div><span class="eyebrow">PRIVATE TALKS</span><h1>1:1 채팅</h1></div><a href="/chat/global">전체 채팅 →</a></div>
<div class="conversation-list"><% conversations.forEach((conversation) => { const other = conversation.userAId === currentUser.id ? conversation.userB : conversation.userA; %><a class="card" href="/chat/<%= conversation.id %>"><div class="avatar small"><%= other.nickname.slice(0, 1) %></div><div><strong><%= other.nickname %></strong><p><%= conversation.messages[0]?.body || '대화를 시작해 보세요.' %></p></div><span>→</span></a><% }) %></div>
<% if (!conversations.length) { %><div class="empty"><h2>아직 대화가 없습니다.</h2><p>상품 상세에서 판매자에게 채팅을 걸어보세요.</p></div><% } %>
<%- include('../partials/footer') %>

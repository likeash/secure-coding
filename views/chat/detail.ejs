<%- include('../partials/header', { title }) %>
<div class="page-head"><div><span class="eyebrow">DIRECT MESSAGE</span><h1><a class="user-link" href="/users/<%= other.id %>"><%= other.nickname %></a>님과의 대화</h1></div><a href="/chat">← 목록</a></div>
<section class="chat-box card" id="chat-box" data-conversation-id="<%= conversation.id %>" data-current-user-id="<%= currentUser.id %>"><div class="messages" id="messages"><% conversation.messages.forEach((message) => { %><article class="message <%= message.sender.id === currentUser.id ? 'mine' : '' %>"><div><strong><%= message.sender.nickname %></strong><time><%= message.createdAt.toLocaleString('ko-KR') %></time></div><p><%= message.body %></p></article><% }) %></div><form class="message-form" id="message-form" method="post" action="/chat/<%= conversation.id %>/messages"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="body" id="message-input" rows="2" maxlength="1000" required placeholder="메시지를 입력하세요 (Enter: 전송, Shift+Enter: 줄바꿈)"></textarea><button class="button" id="message-send">보내기</button></form><p class="muted" id="chat-status"></p></section>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/chat-detail.js" defer></script>
<%- include('../partials/footer') %>

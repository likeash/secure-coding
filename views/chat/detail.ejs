<%- include('../partials/header', { title }) %>
<div class="page-head"><div><span class="eyebrow">DIRECT MESSAGE</span><h1><%= other.nickname %>님과의 대화</h1></div><a href="/chat">← 목록</a></div>
<section class="chat-box card"><div class="messages"><% conversation.messages.forEach((message) => { %><article class="message <%= message.sender.id === currentUser.id ? 'mine' : '' %>"><div><strong><%= message.sender.nickname %></strong><time><%= message.createdAt.toLocaleString('ko-KR') %></time></div><p><%= message.body %></p></article><% }) %></div><form class="message-form" method="post" action="/chat/<%= conversation.id %>/messages"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="body" rows="2" maxlength="1000" required placeholder="메시지를 입력하세요"></textarea><button class="button">보내기</button></form></section>
<%- include('../partials/footer') %>

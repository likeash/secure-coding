<%- include('../partials/header', { title }) %>
<div class="page-head"><div><span class="eyebrow">CONTROL ROOM</span><h1>관리자 센터</h1><p>중요 작업은 모두 감사 로그에 기록됩니다.</p></div></div>
<section class="stats"><div><strong><%= stats.users %></strong><span>사용자</span></div><div><strong><%= stats.products %></strong><span>상품</span></div><div><strong><%= stats.reports %></strong><span>신고</span></div><div><strong><%= stats.transfers %></strong><span>송금</span></div></section>
<details open class="admin-section"><summary>사용자 관리</summary><div class="table-wrap"><table><thead><tr><th>사용자</th><th>역할</th><th>잔액</th><th>신고</th><th>제한</th><th>조치</th></tr></thead><tbody><% users.forEach((user) => { %><tr><td><%= user.nickname %> (<%= user.username %>)</td><td><%= user.role %></td><td><%= user.balance.toLocaleString() %>P</td><td><%= user._count.userReportsReceived %></td><td><%= user.dormantUntil ? user.dormantUntil.toLocaleString('ko-KR') : '-' %></td><td><% if (user.role !== 'ADMIN') { %><div class="actions"><form method="post" action="/admin/users/<%= user.id %>/suspend"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" maxlength="300" placeholder="사유"><button class="danger">30일 정지</button></form><form method="post" action="/admin/users/<%= user.id %>/activate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary">해제</button></form></div><% } %></td></tr><% }) %></tbody></table></div></details>
<details open class="admin-section"><summary>상품 관리</summary><div class="table-wrap"><table><thead><tr><th>상품</th><th>판매자</th><th>상태</th><th>신고</th><th>조치</th></tr></thead><tbody><% products.forEach((product) => { %><tr><td><a href="/products/<%= product.id %>"><%= product.name %></a></td><td><%= product.owner.nickname %></td><td><%= product.status %></td><td><%= product._count.reports %></td><td><form method="post" action="/admin/products/<%= product.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= product.status === 'ACTIVE' ? 'BLOCKED' : 'ACTIVE' %>"><button class="<%= product.status === 'ACTIVE' ? 'danger' : 'secondary' %>"><%= product.status === 'ACTIVE' ? '차단' : '복구' %></button></form></td></tr><% }) %></tbody></table></div></details>
<details class="admin-section"><summary>신고 검토 (<%= reports.length %>)</summary><div class="table-wrap"><table><thead><tr><th>신고자</th><th>대상</th><th>사유</th><th>시각</th><th>조치</th></tr></thead><tbody><% reports.forEach((report) => { %><tr><td><%= report.reporter.nickname %></td><td><%= report.product?.name || report.targetUser?.nickname || '-' %></td><td><%= report.reason %></td><td><%= report.createdAt.toLocaleString('ko-KR') %></td><td><form method="post" action="/admin/reports/<%= report.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary">검토 완료</button></form></td></tr><% }) %></tbody></table></div></details>
<details class="admin-section"><summary>전체 채팅 관리</summary><div class="table-wrap"><table><thead><tr><th>작성자</th><th>내용</th><th>시각</th><th>조치</th></tr></thead><tbody><% messages.forEach((message) => { %><tr><td><%= message.sender.nickname %></td><td><%= message.body %></td><td><%= message.createdAt.toLocaleString('ko-KR') %></td><td><form method="post" action="/admin/messages/<%= message.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">삭제</button></form></td></tr><% }) %></tbody></table></div></details>
<details class="admin-section"><summary>1:1 채팅 관리</summary><div class="table-wrap"><table><thead><tr><th>대화 참여자</th><th>작성자</th><th>내용</th><th>시각</th><th>조치</th></tr></thead><tbody><% directMessages.forEach((message) => { %><tr><td><%= message.conversation.userA.nickname %> / <%= message.conversation.userB.nickname %></td><td><%= message.sender.nickname %></td><td><%= message.body %></td><td><%= message.createdAt.toLocaleString('ko-KR') %></td><td><form method="post" action="/admin/direct-messages/<%= message.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">삭제</button></form></td></tr><% }) %></tbody></table></div></details>
<details class="admin-section"><summary>송금 내역 (읽기 전용)</summary><div class="table-wrap"><table><thead><tr><th>보낸 사람</th><th>받은 사람</th><th>금액</th><th>메모</th><th>시각</th></tr></thead><tbody><% transfers.forEach((transfer) => { %><tr><td><%= transfer.sender.nickname %></td><td><%= transfer.receiver.nickname %></td><td><%= transfer.amount.toLocaleString() %>P</td><td><%= transfer.memo %></td><td><%= transfer.createdAt.toLocaleString('ko-KR') %></td></tr><% }) %></tbody></table></div></details>
<details class="admin-section"><summary>관리자 감사 로그</summary><div class="table-wrap"><table><thead><tr><th>관리자</th><th>작업</th><th>대상</th><th>상세</th><th>시각</th></tr></thead><tbody><% audits.forEach((entry) => { %><tr><td><%= entry.admin.nickname %></td><td><%= entry.action %></td><td><%= entry.targetType %> #<%= entry.targetId %></td><td><%= entry.detail %></td><td><%= entry.createdAt.toLocaleString('ko-KR') %></td></tr><% }) %></tbody></table></div></details>
<%- include('../partials/footer') %>
